# Application
MAGICPIN_DATABASE_PATH=data/context_store.db

# Submission metadata — fill these in with your real team info before
# submitting. Leave unset (commented out/absent) and they will be omitted
# or null in /v1/metadata, or use the built-in factual default (approach),
# rather than reporting a fake placeholder value.
MAGICPIN_TEAM_NAME=
MAGICPIN_TEAM_MEMBERS=
# MAGICPIN_MODEL only needs to be set if you want /v1/metadata to report a
# model name other than whatever GEMINI_MODEL is configured to.
# MAGICPIN_MODEL=
# MAGICPIN_APPROACH=describe your own approach here if you want to override
# the built-in default description
MAGICPIN_CONTACT_EMAIL=
MAGICPIN_VERSION=0.1.0
MAGICPIN_SUBMITTED_AT=

# Gemini (optional; the composer safely falls back to deterministic
# behavior when GEMINI_API_KEY is not set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Development-only logging. Prompts may contain synthetic merchant/customer context.
MAGICPIN_DEBUG_LOG_PROMPTS=false
